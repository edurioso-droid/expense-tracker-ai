{
  "expo": {
    "name": "copal",
    "slug": "copal",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.copal",
      "infoPlist": {
        "NSUserTrackingUsageDescription": "No recopilamos datos de seguimiento.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.copal",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "edgeToEdgeEnabled": true,
      "userPermissions": []
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font"
    ],
    "scheme": "copal"
  }
}
